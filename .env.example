# Control plane
TRANSFLUX_ENV=dev                 # dev | prod
TRANSFLUX_HTTP_ADDR=:8080
TRANSFLUX_LOG_LEVEL=info          # debug | info | warn | error
TRANSFLUX_DATABASE_URL=postgres://transflux:transflux@localhost:7432/transflux?sslmode=disable

# Object storage: any S3-compatible endpoint. Leave the endpoint empty for AWS.
TRANSFLUX_S3_ENDPOINT=http://localhost:7900
# What clients and workers can reach, if that differs from the endpoint the
# control plane uses (it does inside Docker). Presigned URLs are signed for it.
TRANSFLUX_S3_PUBLIC_ENDPOINT=http://localhost:7900
TRANSFLUX_S3_REGION=us-east-1
TRANSFLUX_S3_BUCKET=transflux
TRANSFLUX_S3_ACCESS_KEY=transflux
TRANSFLUX_S3_SECRET_KEY=transflux123
TRANSFLUX_S3_PATH_STYLE=true      # MinIO and most self-hosted gateways need this

# Worker fleet. Authenticates registration only: a worker exchanges it
# immediately for a per-worker credential. Use a real secret outside dev.
TRANSFLUX_WORKER_BOOTSTRAP_TOKEN=dev-worker-bootstrap

# Compose. Host ports default to a distinctive range so the stack does not
# collide with a local Postgres on 5432 or other projects on 8080/9000.
TRANSFLUX_HTTP_PORT=7080
TRANSFLUX_PG_PORT=7432
TRANSFLUX_S3_PORT=7900
TRANSFLUX_S3_CONSOLE_PORT=7901
POSTGRES_PASSWORD=transflux
WORKER_BOOTSTRAP_TOKEN=dev-worker-bootstrap
S3_ACCESS_KEY=transflux
S3_SECRET_KEY=transflux123

# Integration tests. Both are optional: the suites that need them skip when
# unset. The migration test DROPS its schema, so use a throwaway database.
TRANSFLUX_TEST_DATABASE_URL=postgres://transflux:transflux@localhost:7432/transflux_test?sslmode=disable
TRANSFLUX_TEST_S3_ENDPOINT=http://localhost:7900
TRANSFLUX_TEST_S3_ACCESS_KEY=transflux
TRANSFLUX_TEST_S3_SECRET_KEY=transflux123
