# Control plane
TRANSFLUX_ENV=dev                 # dev | prod
TRANSFLUX_HTTP_ADDR=:8080
TRANSFLUX_LOG_LEVEL=info          # debug | info | warn | error
TRANSFLUX_DATABASE_URL=postgres://transflux:transflux@localhost:5432/transflux?sslmode=disable

# Compose
POSTGRES_PASSWORD=transflux

# Integration tests: a throwaway database. The migration test DROPS its schema.
TRANSFLUX_TEST_DATABASE_URL=postgres://transflux:transflux@localhost:5432/transflux_test?sslmode=disable
